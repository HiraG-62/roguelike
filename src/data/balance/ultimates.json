{
  "_note": "奥義（F で奥義ゲージを使って出す。docs/ideas/ougi-and-dual-actions.md 3 章）。common は全奥義に共通の値、defs.<武器種>.<奥義の名前> は奥義ごとの数値で、src/data/ultimates.ts が UltimateDef に組み立てる（状態異常・形・弾の種類など union 文字列は TS 側）。旧 combat.json の PLAYER.special（旧バースト）を値を変えずに common と defs.sword.fullMoon（円月）へ移した（2026-09-25 Lane 0）。係数は docs/STATS_AND_SCALING.md 2 章（奥義は 3 種以上の係数を許す例外）。基準: 基礎値で周囲攻撃 34 前後（円月）、単体の大技 55〜75、多段は合計 50〜70、持続は 8 秒前後（drain 12.5/秒）で倍率 1.2〜1.5。円月は溜めた気力を練って放つ魔法の一撃なので威力・怯み値とも精神 + 霊力（poiseRatio は怯み値 60 × 3% = 1.8 を 1 点ぶんとして等分。2026-09-24、A-10）。69 本の初期値は 2026-09-25 Lane B（QA 前の目安。統合後に balance-tuner が詰める）",
  "ULTIMATE": {
    "_fields": {
      "cost": "奥義 1 回に要る奥義ゲージ。PLAYER.maxEnergy と同じにすると満タンでだけ撃てる。目安 100",
      "invuln": "出した後（突進は踏み込みの間）の無敵の秒。目安 0.1〜0.5",
      "radius": "周囲攻撃（nova）・着弾の爆発（blast）・引き寄せ（pull）・纏い（aura）の半径（px。10px = 1m）。nova / pull / aura には burstRadiusMul が掛かる。目安 30〜80",
      "scaling": "1 ヒットの威力の係数表（base + Σ 係数 × ステータス）。burstDamageMul が掛かる。基礎値（各 5）で周囲攻撃 34 前後、単体の大技 55〜75",
      "poise": "1 ヒットの怯み値（ステータスが基礎値のとき）。poiseDamageMul が掛かる。目安 8〜100",
      "poiseRatio": "怯み値のステータス係数（ステータス 1 あたりの上乗せ）",
      "knockback": "当てた敵を押し飛ばす速さ（px/秒）。knockbackMul が掛かる。目安 60〜600",
      "hits": "同じ敵に当てる回数（多段。省略は 1）。威力・怯み値は 1 ヒットぶん",
      "heavy": "重い一撃（重いヒットストップ・壁叩きつけ）",
      "deg": "扇の中心角（度。swing の形が扇のとき）",
      "reach": "振りの届く距離（px）。扇・突きは長さ、円は自分から円の中心までの距離（0 = 自分の周り）",
      "size": "振りの大きさ（px）。突きは帯の幅、円は直径、箱は一辺",
      "distance": "突進（lunge）の進む距離 / 着弾（blast）の照準方向の距離（px）。近くに敵がいればその位置へ寄せる",
      "width": "突進で斬る帯の幅（px）",
      "toDistance": "引き寄せ（pull）で敵を寄せる先の、自分からの距離（px）",
      "count": "弾の数 / 着弾の数",
      "spreadDeg": "複数の弾・着弾の扇の間隔（度）。360 / count で全周",
      "speedMul": "弾速の倍率（1 = 等倍）",
      "lifeMul": "弾の寿命（射程）の倍率（1 = 等倍）",
      "bulletRadius": "弾の当たり判定の半径（px）",
      "pierceBonus": "弾の貫通数の上乗せ（99 = 実質すべて貫く）",
      "selfKnock": "撃った反動で自分が後ろへ下がる強さ（px/秒）",
      "execute": "周囲攻撃で即死させる生命の割合（0..1。ボスには効かない）",
      "terrainDuration": "着弾に残す地形の秒",
      "stacks": "状態異常のスタック数",
      "duration": "状態異常・強化の秒",
      "potency": "状態異常の効果量（基礎値のステータスのとき）",
      "damageMul": "威力の倍率（1 = 等倍）。buff は自分の与ダメ強化、detonate は起爆する設置弾の威力",
      "heal": "生命の回復（最大生命に対する割合 0..1）",
      "healPerKill": "倒した数 × この割合（最大生命に対する割合）を回復",
      "mana": "気力の回復量（上限を超えない）",
      "drainPerSec": "持続の奥義で毎秒減る奥義ゲージ。100 / drainPerSec が最長の秒。目安 10〜16",
      "minSec": "持続の奥義がゲージ 0 でも続く最短の秒（出した直後に切れないように）",
      "mul": "持続中の倍率（1 = 等倍）。damage = 近接・射撃の与ダメ、attackSpeed = 振りの速さ、fireRate = 射撃の間隔の逆数、moveSpeed = 移動、poise = 近接の怯み値、incoming = 被ダメ",
      "critAdd": "持続中の会心率の上乗せ（0..1）",
      "vsWindup": "持続中、予備動作中の敵への与ダメの倍率",
      "vsStatus": "持続中、その状態異常を持つ敵への与ダメの倍率（状態異常の種類は TS）",
      "guardArcDeg": "持続中、正面からこの角度（度）以内の被弾を軽くする",
      "guardMul": "正面の被弾の倍率（0..1）",
      "stillFireRate": "持続中、立ち止まっているときの射撃間隔の逆数の倍率",
      "patch": "持続中の近接の段の差し替え。reachMul / sizeMul = 届く距離・大きさの倍率、hitsAdd = 多段の上乗せ、chargeTimeMul = 溜めの段に届く秒の倍率、attackMoveMul = 攻撃中・溜め中の移動の倍率",
      "shot": "持続中の射撃の弾の差し替え。pelletsAdd = 弾数の上乗せ、pierceAdd = 貫通の上乗せ、speedMul = 弾速、damageMul = 威力、recoilMul = 反動、fuseMul = 設置弾の信管の秒、bounceAdd = 跳弾の回数の上乗せ",
      "aura": "持続中、自分の周りへ interval 秒ごとに与えるダメージ（radius は burstRadiusMul、威力は burstDamageMul が掛かる）",
      "interval": "纏い・手元返しの間隔（秒）",
      "recall": "持続中、interval 秒ごとに飛んでいる自分の弾を手元へ戻す。returnDamageMul = 戻りの威力、speedMul = 戻りの速さ",
      "minePull": "持続中、床の自分の設置弾が radius（px）以内の敵を speed（px/秒）で引き寄せる",
      "wave": "持続中、振るたびに照準方向へ剣気の波（祝福の断裂波と同じ弾）を出す。magnitude = 振りの威力に対する倍率",
      "magnitude": "統一ルールの効果量（効果ごとに意味が違う。wave / volley は振りの威力・射撃の基礎威力に対する倍率、restoreMana は気力、skillHaste はスキルの再使用を縮める秒、shockwave は近接 1 段目の威力に対する倍率）",
      "icd": "統一ルールの内部の再使用（秒）"
    },
